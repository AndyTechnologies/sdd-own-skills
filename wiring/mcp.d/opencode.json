{
  "runtime": "opencode",
  "target_mode": "opencode-config",
  "merge": "json-key",
  "root_key": "mcp",
  "server_key": "github",
  "selectors": ["opencode", "pi", "claude", "codex"],
  "permission_roots": ["~/.agent_worktrees/**"],
  "deps": ["uv", "donsetch"],
  "presence": "[ -n \"${OPENCODE_CONFIG:-}\" ] || [ -f \"$HOME/.config/opencode/opencode.jsonc\" ] || [ -f \"$HOME/.config/opencode/opencode.json\" ]",
  "block": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "gh-git-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "{{SDD_OWN_DIR}}/srv/gh-mcp-server",
        "python",
        "-m",
        "src.server"
      ]
    },
    "donsetch": {
      "type": "local",
      "enabled": true,
      "command": ["donsetch", "mcp"]
    }
  },
  "alt_docker": {
    "github": {
      "type": "sdk",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "{{ENV_FILE}}",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}