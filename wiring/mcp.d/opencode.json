{
  "runtime": "opencode",
  "target_mode": "opencode-config",
  "merge": "json-key",
  "root_key": "mcp",
  "server_key": "github",
  "presence": "[ -n \"${OPENCODE_CONFIG:-}\" ] || [ -f \"$HOME/.config/opencode/opencode.jsonc\" ] || [ -f \"$HOME/.config/opencode/opencode.json\" ]",
  "block": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "oauth": false
    },
    "gh-git-mcp": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/andy/Proyectos/sdd-own-skills/srv/gh-mcp-server",
        "python",
        "src/server.py"
      ]
    }
  },
  "alt_docker": {
    "github": {
      "type": "sdk",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "{{ENV_FILE}}",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}