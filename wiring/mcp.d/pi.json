{
  "runtime": "pi",
  "target_mode": "path",
  "target": "~/.pi/agent/mcp.json",
  "merge": "json-key",
  "root_key": "mcpServers",
  "server_key": "github",
  "selectors": ["opencode", "pi", "claude", "codex"],
  "permission_roots": ["~/agent_worktrees/**"],
  "deps": ["uv", "donsetch"],
  "presence": "command -v pi >/dev/null 2>&1",
  "block": {
    "github": {
      "auth": "bearer",
      "url": "https://api.githubcopilot.com/mcp/",
      "bearerTokenEnv": "GITHUB_PERSONAL_ACCESS_TOKEN"
    },
    "donsetch": {
      "command": "donsetch",
      "args": ["mcp"]
    }
  },
  "alt_docker": {
    "github": {
      "type": "sdk",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "{{ENV_FILE}}",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}