{
  "runtime": "claude",
  "target_mode": "path",
  "target": "~/.claude.json",
  "merge": "json-key",
  "root_key": "mcpServers",
  "server_key": "github",
  "presence": "command -v claude",
  "block": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "alt_docker": {
    "github": {
      "type": "sdk",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "{{ENV_FILE}}",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}